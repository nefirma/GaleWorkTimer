<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GaleWorkTimer.ViewModels"
        xmlns:domain="using:GaleWorkTimer.Domain"
        x:Class="GaleWorkTimer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GaleWorkTimer" Width="1020" Height="660" MinWidth="760" MinHeight="420"
        WindowDecorations="Full" ExtendClientAreaToDecorationsHint="False"
        CanMinimize="True" CanMaximize="True" CanResize="True">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <TextBlock Text="GaleWorkTimer" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Minimize" Click="MinimizeWindow" Margin="0" FontSize="12" Padding="12,6" />
        <Button Content="Exit" Click="ExitApplication" Margin="0" FontSize="12" Padding="12,6" />
      </StackPanel>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <TabControl x:Name="Navigation" SelectionChanged="Navigate">
      <TabItem Header="Timers">
        <DockPanel Margin="0,16,0,0">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Name" VerticalAlignment="Center" />
            <TextBox x:Name="NewName" AutomationProperties.Name="Timer name" Width="250" Margin="8,0,16,8" />
            <TextBlock Text="Color" VerticalAlignment="Center" />
            <ComboBox x:Name="NewColor" AutomationProperties.Name="Timer color" Width="150" Margin="8,0,16,8"
                      ItemsSource="{x:Static domain:TimerPalette.Colors}" />
            <Button Content="+ Add timer" Click="AddTimer" />
            <Button Content="Refresh" Click="RefreshTimers" />
          </WrapPanel>
          <ScrollViewer>
            <StackPanel Spacing="16">
              <ItemsControl ItemsSource="{Binding Timers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimerRow">
                    <Border BorderThickness="0,0,0,1" BorderBrush="Gray" Padding="0,12">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="timerTitle" Text="{Binding Name}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock VerticalAlignment="Center"><Run Text="Total: " /><Run Text="{Binding TotalText}" /></TextBlock>
                          <TextBlock Grid.Column="1" Classes="status"
                                     Classes.stopped="{Binding CanStart}" Classes.running="{Binding CanPause}"
                                     Classes.paused="{Binding CanResume}" MinWidth="100"
                                     VerticalAlignment="Center" Margin="16,0,0,0">
                            <Run Text="● " /><Run Text="{Binding StatusText}" />
                          </TextBlock>
                        </Grid>
                        <WrapPanel>
                          <Button Content="Start" IsVisible="{Binding CanStart}" Click="StartTimer" />
                          <Button Content="Pause" IsVisible="{Binding CanPause}" Click="PauseTimer" />
                          <Button Content="Resume" IsVisible="{Binding CanResume}" Click="ResumeTimer" />
                          <Button Content="Stop" IsVisible="{Binding CanStop}" Click="StopTimer" />
                          <Button Content="Edit" Click="EditTimer" />
                          <Button Content="Remove from list" Click="ArchiveTimer" />
                          <Button Classes="destructive" Content="Delete" IsEnabled="{Binding CanDelete}" Click="DeleteTimer" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Expander Header="Archived timers" HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding ArchivedTimers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimerRow">
                      <StackPanel Spacing="10" Margin="0,8">
                        <TextBlock Classes="timerTitle" Text="{Binding Name}" />
                        <TextBlock><Run Text="Total: " /><Run Text="{Binding TotalText}" /></TextBlock>
                        <WrapPanel>
                          <Button Content="Edit" Click="EditTimer" />
                          <Button Content="Restore to list" Click="RestoreTimer" />
                          <Button Classes="destructive" Content="Delete" IsEnabled="{Binding CanDelete}" Click="DeleteTimer" />
                        </WrapPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="History">
        <DockPanel Margin="0,16,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button Content="Refresh" Click="RefreshHistory" />
            <TextBlock Text="{Binding SnapshotText}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                  <Border BorderThickness="0,0,0,1" BorderBrush="Gray" Padding="0,12">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="timerTitle" Text="{Binding TimerName}" />
                        <TextBlock Grid.Column="1" Classes="status" Classes.stopped="{Binding IsStopped}"
                                   Classes.running="{Binding IsRunning}" Classes.paused="{Binding IsPaused}"
                                   MinWidth="100" VerticalAlignment="Center" Margin="16,0,0,0">
                          <Run Text="● " /><Run Text="{Binding Status}" />
                        </TextBlock>
                      </Grid>
                      <WrapPanel>
                        <TextBlock Text="Start: " />
                        <TextBlock Text="{Binding StartText}" Margin="0,0,20,0" />
                        <TextBlock Text="Stop: " />
                        <TextBlock Text="{Binding StopText}" Classes="status"
                                   Classes.running="{Binding IsRunning}" Classes.paused="{Binding IsPaused}" />
                      </WrapPanel>
                      <WrapPanel>
                        <TextBlock Text="Active: " />
                        <TextBlock Text="{Binding ActiveText}" Margin="0,0,20,0" />
                        <TextBlock Text="Paused: " />
                        <TextBlock Text="{Binding PausedText}" Margin="0,0,20,0" />
                        <TextBlock Text="Pauses: " />
                        <TextBlock Text="{Binding Snapshot.PauseCount}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
